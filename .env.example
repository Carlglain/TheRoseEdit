# Supabase — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses RLS. Server-only — never prefix with NEXT_PUBLIC_,
# never import it into a client component (lib/supabase/server.ts guards this at build time).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys in the Stripe dashboard. Use a test-mode secret key (sk_test_…)
# while developing. Server-only — never prefix with NEXT_PUBLIC_. Checkout is hosted/redirect-
# based (Stripe Checkout Sessions), so no publishable key is needed client-side yet.
STRIPE_SECRET_KEY=

# Signing secret for the fulfillment webhook at /api/webhooks/stripe. In production, get this
# from Developers → Webhooks → your endpoint in the Stripe dashboard. Locally, `stripe listen`
# prints one each time you run it (see README test plan).
STRIPE_WEBHOOK_SECRET=

# Base URL used to build Stripe's success_url/cancel_url and the download links sent by email.
# Update to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys. Server-only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address for transactional email (order confirmations). Must be on a domain verified in
# Resend (Domains → Add Domain) before it'll deliver to real inboxes. Leave unset during
# development to use Resend's shared onboarding@resend.dev test sender.
RESEND_FROM_EMAIL=

# PayPal — https://developer.paypal.com/dashboard/applications
# NEXT_PUBLIC_PAYPAL_CLIENT_ID: shown in the App detail page; safe to expose client-side.
# PAYPAL_CLIENT_ID: same value, server-side copy used for OAuth2 access-token requests.
# PAYPAL_CLIENT_SECRET: Secret key — server-only, never prefix with NEXT_PUBLIC_.
# PAYPAL_ENVIRONMENT: "sandbox" (default) or "live".
# PAYPAL_WEBHOOK_ID: Created under Apps & Credentials → your app → Webhooks. Copy the Webhook ID
#   (not the URL) — used by verifyPayPalWebhookSignature to call PayPal's verification endpoint.
#   Subscribe to event: PAYMENT.CAPTURE.COMPLETED.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Coaching / Booking (Cal.com)
# ─────────────────────────────────────────────────────────────────────────────
# Setup (one-time for Rose):
#   1. Create a free account at https://cal.com
#   2. Create an Event Type (e.g. "1:1 Coaching" · 45 min)
#   3. Settings → Calendars → Connect Google Calendar
#      (busy times block slots; new bookings appear on her calendar)
#   4. Copy the event link, e.g. https://cal.com/rose/coaching
#   5. Paste it into BOOKING_URL below (or use the short form: rose/coaching)
#
# BOOKING_URL: Cal.com event URL or path.
#   - BOOKING_REQUIRES_PAYMENT=false → calendar embeds on /coaching (book free / Cal handles pay)
#   - BOOKING_REQUIRES_PAYMENT=true  → Stripe first, then calendar embeds on /coaching/success
# BOOKING_REQUIRES_PAYMENT: "true" to require Stripe before picking a slot; "false" (default)
#   to show the calendar immediately (or let Cal.com collect payment itself).
# COACHING_STRIPE_PRICE_ID: Stripe Price for the call ($120 / 45 min). Pay-first mode only.
#   Server-only — never prefix with NEXT_PUBLIC_.
BOOKING_URL=
BOOKING_REQUIRES_PAYMENT=false
COACHING_STRIPE_PRICE_ID=

# Contact
# CONTACT_WHATSAPP: full wa.me URL for the WhatsApp button on /contact, e.g. https://wa.me/4712345678
# Leave unset to hide the WhatsApp button entirely.
CONTACT_WHATSAPP=
